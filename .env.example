# ============================================================================
# Copy this file to `.env` in the repository root:  cp .env.example .env
# The backend reads it for local dev (`make backend`) and docker compose.
# Every provider key is OPTIONAL. Configure only the ones you use, or paste a key in the UI.
# ============================================================================

# --- LLM providers -----------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=            # Gemini
DEEPSEEK_API_KEY=
XAI_API_KEY=               # Grok
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Defaults ----------------------------------------------------------------
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini

# --- Embeddings (RAG) --------------------------------------------------------
# openai | google | ollama | huggingface
EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_MODEL=text-embedding-3-small
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVER_K=4

# --- Agent behaviour ---------------------------------------------------------
CHECKPOINTER=sqlite        # sqlite | memory
MAX_CONTEXT_TOKENS=6000    # older turns are summarized beyond this budget
KEEP_LAST_MESSAGES=6       # recent messages kept verbatim after summarizing
RECURSION_LIMIT=25
ENABLE_LLM_CACHE=false
PYTHON_REPL_TIMEOUT=10

# --- Server ------------------------------------------------------------------
ENVIRONMENT=development    # development | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATA_DIR=./data
# Require `Authorization: Bearer <token>` on every /api call (recommended when exposed publicly)
API_AUTH_TOKEN=

# --- Observability: LangSmith tracing (optional) -----------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-ai-project
